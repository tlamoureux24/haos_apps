ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# CI-only image. strace is never installed in the distributed App image.
RUN apk add --no-cache strace

ENTRYPOINT ["/usr/bin/strace", "-ff", "-qq", "-e", "trace=execve,execveat", "-o", "/tmp/apparmor-audit/exec"]
# s6 requires /init itself to be PID 1, so its immutable package inventory is
# checked separately. This trace covers the complete application launcher.
CMD ["/run.sh"]
